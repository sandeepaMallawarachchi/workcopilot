# Browser safe: publishable key preferred; legacy anon key supported
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server / Supabase Edge secrets only
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=
# Comma separated internationally formatted Meta-verified test recipients
WHATSAPP_TEST_RECIPIENTS=
GROQ_API_KEY=
GROQ_MODEL=
# Preferred GitHub App installation: all three required
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
# Development-only, minimum read scopes
GITHUB_TOKEN=
ALLOW_DEV_GITHUB_TOKEN=false
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# Email: 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set the SAME value in .env, Vercel and Supabase secrets. Changing it makes saved mailbox passwords unreadable.
EMAIL_ENCRYPTION_KEY=
INTERNAL_JOB_SECRET=
ADMIN_EMAIL=

